{
  "name": "agentic-checkout",
  "version": "0.1.2",
  "description": "Stripe Payment Links creation and status checks for Node.js and TypeScript, with dry-run CLI and Model Context Protocol tools.",
  "keywords": [
    "stripe",
    "stripe-payment-links",
    "stripe-checkout",
    "payment-link",
    "payments",
    "typescript",
    "nodejs",
    "cli",
    "mcp",
    "model-context-protocol",
    "dry-run",
    "zod"
  ],
  "license": "MIT",
  "author": "Pooria Arab",
  "repository": {
    "type": "git",
    "url": "https://github.com/pooriaarab/agentic-checkout.git"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.pooriaarab/agentic-checkout",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agentic-checkout": "./dist/cli.js",
    "agentic-checkout-mcp": "./dist/mcp-bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
